# Секрет для авторизации запросов от PsyCont. Сгенерируй свой:
#   openssl rand -hex 32
# Тот же самый токен пропиши на проде PsyCont как WHISPER_SERVICE_TOKEN.
WHISPER_SERVICE_TOKEN=replace_me_with_openssl_rand_hex_32

# Необязательные (по умолчанию можно не задавать):
# WHISPER_MODEL=small          # small старт, medium если качество слабое (втрое тяжелее)
# WHISPER_COMPUTE=int8         # int8 экономит память на CPU
# WHISPER_LANGUAGE=ru          # форсим русский, не тратим время на автодетект
# WHISPER_MAX_BYTES=26214400   # 25 МБ, потолок размера аудио
# WHISPER_TIMEOUT_SEC=300      # верхний порог на одну расшифровку, потом 504
