[Unit]
Description=PsyCont voice transcriber (faster-whisper)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/psycont-transcriber
EnvironmentFile=/opt/psycont-transcriber/.env
# --workers 1 обязателен: каждый воркер грузит свою копию модели в RAM, на 2 ядрах
# несколько воркеров = смерть по памяти. НЕ поднимать. Параллелизм закрыт очередью в коде.
ExecStart=/opt/psycont-transcriber/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8090 --workers 1
Restart=always
RestartSec=5
# Ужесточение процесса. PrivateTmp: временное аудио в изолированном /tmp, стирается со службой.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
