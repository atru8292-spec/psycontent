# Пример переменных окружения PsyCont. Значения не настоящие: настоящие лежат в .env.local (в git не попадает)
# и на сервере. Секреты сюда не писать.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI и генерация (CLAUDE.md, «НОВЫЙ МОЗГ ГЕНЕРАЦИИ»)
OPENAI_API_KEY=
NEW_GENERATION_PIPELINE=off
NEXT_PUBLIC_NEW_GENERATION_PIPELINE=
GENERATION_MODE=simple
GENERATION_MODEL=
GENERATION_WRITER_MODEL=

# Вход через Яндекс
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Свой Whisper (голос)
WHISPER_SERVICE_URL=
WHISPER_SERVICE_TOKEN=

# Расшифровка YouTube (старый /api/transcribe)
SUPADATA_API_KEY=

# Кабинет аналитики /admin (CLAUDE.md, «АНАЛИТИКА И КАБИНЕТ»)
# Кто видит кабинет: почты через запятую, без учета регистра. Пусто значит кабинет закрыт для всех (404).
ADMIN_EMAILS=
# Служебные аккаунты (Арина, тестовые): их нигде не считаем, в кабинете переключатель «Показать служебных».
# Тариф code = 'test' тоже служебный, отдельно перечислять не нужно.
INTERNAL_EMAILS=
# Часовой пояс для «сегодня» и дней недели в кабинете
ADMIN_TZ=Asia/Barnaul

# Яндекс SmartCaptcha на регистрации (16.11). Без ключей капча выключена, работают ловушка, скорость и пределы
NEXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# Оплата ЮKassa (17.11, feat/oplata). Без ключей оплата выключена (кнопки ведут на «оплата скоро»).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# только для проверок на заглушке; на проде не задавать (по умолчанию https://api.yookassa.ru/v3)
YOOKASSA_API_URL=
# секрет таймера оплаты (не короче 32 знаков), тот же в /etc/psycont-billing.secret
CRON_SECRET=
# письма об оплате через SMTP.bz
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PsyCont <noreply@psycont.ru>
SITE_PUBLIC_URL=https://psycont.ru
# Утренняя сводка Арине в Telegram (scripts/digest.ts, аналитика 2). Без них сводка не отправляется и не падает.
# В сводке нет почт и текстов: только цифры, имена из профиля и короткий номер.
DIGEST_TG_BOT_TOKEN=
DIGEST_TG_CHAT_ID=
# секрет для будущего защищенного роута сводки; скрипту по cron не нужен
DIGEST_SECRET=
