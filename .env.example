# Пример переменных окружения PsyCont. Значения не настоящие: настоящие лежат в .env.local (в git не попадает)
# и на сервере. Секреты сюда не писать.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI и генерация (CLAUDE.md, «НОВЫЙ МОЗГ ГЕНЕРАЦИИ»)
OPENAI_API_KEY=
NEW_GENERATION_PIPELINE=off
NEXT_PUBLIC_NEW_GENERATION_PIPELINE=
GENERATION_MODE=simple
GENERATION_MODEL=
GENERATION_WRITER_MODEL=

# Вход через Яндекс
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Свой Whisper (голос)
WHISPER_SERVICE_URL=
WHISPER_SERVICE_TOKEN=

# Расшифровка YouTube (старый /api/transcribe)
SUPADATA_API_KEY=

# Кабинет аналитики /admin (CLAUDE.md, «АНАЛИТИКА И КАБИНЕТ»)
# Кто видит кабинет: почты через запятую, без учета регистра. Пусто значит кабинет закрыт для всех (404).
ADMIN_EMAILS=
# Служебные аккаунты (Арина, тестовые): их нигде не считаем, в кабинете переключатель «Показать служебных».
# Тариф code = 'test' тоже служебный, отдельно перечислять не нужно.
INTERNAL_EMAILS=
# Часовой пояс для «сегодня» и дней недели в кабинете
ADMIN_TZ=Asia/Barnaul
