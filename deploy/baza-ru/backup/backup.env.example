# Настройки бэкапа. На сервере: /opt/supabase/backup/backup.env (права 600, только root).
# Куда класть копии и сколько хранить
BACKUP_DIR=/var/backups/psycont
KEEP=7
# Кому писать, если бэкап не сделался
ALERT_TO=atru8292@gmail.com

# S3 Selectel. Пока пусто: копии лежат только на сервере. Где взять значения, написано в PEREEZD-BAZY.md, раздел «Бэкап».
# S3_ENDPOINT: домен S3 API пула бакета (панель Selectel, бакет, вкладка с доменами), например https://s3.ru-1.storage.selcloud.ru
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=
S3_PREFIX=psycont
S3_ACCESS_KEY=
S3_SECRET_KEY=
