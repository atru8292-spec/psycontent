}

db.psycont.ru {
	encode gzip
	# проверка живости для внешнего мониторинга (UptimeRobot, 11.11): маленький запрос в базу через PostgREST,
	# наружу только «ok» 200 или «fail» 503, без данных и без ключа (запрос идет роли anon, как у сайта).
	# Только GET и HEAD (остальные методы уходят в общий 404), заголовки клиента, меняющие роль, схему или запрос,
	# срезаются, путь и query заменяются целиком; таймаут 5 с, чтобы зависший PostgREST не держал соединение (ревью 11.11)
	@health {
		path /health
		method GET HEAD
	}
	handle @health {
		rewrite * /plans?select=code&limit=1
		reverse_proxy rest:3000 {
			header_up -Authorization
			header_up -Prefer
			header_up -Accept-Profile
			header_up -Content-Profile
			transport http {
				response_header_timeout 5s
			}
			@ok status 2xx
			handle_response @ok {
				respond "ok" 200
			}
			handle_response {
				respond "fail" 503
			}
		}
	}
	# Регистрация по почте только через сайт (16.11, защита от ботов, app/api/auth/signup): прямые /auth/v1/signup,
	# /auth/v1/otp и /auth/v1/magiclink (последние два тоже создают пользователя и шлют письмо) принимаем лишь с сервера
	# сайта, остальным 404. Иначе бот обошел бы проверки сайта, создавал аккаунты без согласия и выедал лимит писем.
	# Сайт /otp и /magiclink не использует; /resend (повторное письмо) и /recover (сброс пароля) открыты.
	# Адрес сервера сайта менять здесь же (переезд сайта, раздел «Переезд сайта в Россию» в CLAUDE.md).
	@signup_outside {
		path /auth/v1/signup /auth/v1/otp /auth/v1/magiclink
		not remote_ip 31.77.197.158
	}
	handle @signup_outside {
		respond "Not found" 404
	}
	@api path /auth/v1/* /rest/v1/* /storage/v1/*
	handle @api {
		reverse_proxy api-gw:8000 {
			# настоящий IP посетителя для лимитов auth; заголовок от клиента перезаписывается
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		respond "Not found" 404
	}
	header -server
	log {
		output stderr
		format console
	}
}

# Вход на сайт через Москву (19.11): российский мобильный интернет режет немецкий IP сайта целиком, поэтому
# psycont.ru смотрит сюда, а Caddy проксирует на сайт в Германии (31.77.197.158, nginx -> pm2 psycont).
# Приложение, база и выкатка остаются как были. Кэша нет: /_next/static Next отдает immutable, браузер берет из своего.
# Настоящий IP посетителя уходит в X-Real-IP (значение клиента перезаписывается); nginx Германии принимает его
# только от 141.133.187.249 (set_real_ip_from), на нем держатся вебхук ЮKassa и лимиты регистрации.
# flush_interval -1: поток генерации (NDJSON) идет без накопления; своего таймаута на ответ нет, предел 120 с у nginx.
# TLS-ALPN выключен: до смены DNS проверку получает Германия и пересылает сюда только HTTP-01.
psycont.ru, www.psycont.ru {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	@www host www.psycont.ru
	redir @www https://psycont.ru{uri} 301
	request_body {
		max_size 30MB
	}
	reverse_proxy https://31.77.197.158 {
		# к https-апстриму Caddy сам ставит Host = адрес апстрима, и редиректы сайта (publicOrigin, Яндекс) уходили
		# на https://31.77.197.158 (проверка 19.11); www сюда не доходит, его редиректит строка выше
		header_up Host psycont.ru
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto https
		flush_interval -1
		transport http {
			tls_server_name psycont.ru
			dial_timeout 5s
			keepalive 120s
		}
	}
	header -server
}

# http: свои проверки Let's Encrypt Caddy отвечает сам, чужие (certbot в Германии продлевает свой сертификат,
# по нему Caddy проверяет апстрим) отдает в Германию; остальное на https://psycont.ru
http://psycont.ru, http://www.psycont.ru {
	handle /.well-known/acme-challenge/* {
		reverse_proxy http://31.77.197.158 {
			header_up Host psycont.ru
		}
	}
	handle {
		redir https://psycont.ru{uri} 301
	}
}

# Шаблоны писем для auth, только внутри сети Docker (порт 8088 не опубликован на хосте)
:8088 {
	root * /srv/email-templates
	file_server
}
