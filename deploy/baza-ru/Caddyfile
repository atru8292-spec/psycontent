db.psycont.ru {
	encode gzip
	@api path /auth/v1/* /rest/v1/* /storage/v1/*
	handle @api {
		reverse_proxy api-gw:8000 {
			# настоящий IP посетителя для лимитов auth; заголовок от клиента перезаписывается
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		respond "Not found" 404
	}
	header -server
	log {
		output stderr
		format console
	}
}

# Шаблоны писем для auth, только внутри сети Docker (порт 8088 не опубликован на хосте)
:8088 {
	root * /srv/email-templates
	file_server
}
